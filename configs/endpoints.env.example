# Copy to configs/endpoints.env and fill in your resources. configs/endpoints.env is git-ignored.
# Existing environment variables take precedence over this file.
# Authentication uses Microsoft Entra ID (`az login`); no keys are needed.

# Speech resource used for Azure Transcribe Fast (ko-KR) and the Speech SDK.
KSTT_SPEECH_KOREACENTRAL_ENDPOINT=https://<speech-resource>.cognitiveservices.azure.com

# Speech resource in a region that offers LLM Speech and MAI-Transcribe in Fast Transcription.
KSTT_SPEECH_EASTUS_ENDPOINT=https://<speech-resource-eastus>.cognitiveservices.azure.com

# Azure OpenAI endpoint of the AI Services resource that has the kstt-* deployments.
KSTT_AOAI_ENDPOINT=https://<ai-services-resource>.openai.azure.com

# Host name (no scheme) of the same AI Services resource, for MAI Realtime and Voice Live.
KSTT_AI_SERVICES_HOST=<ai-services-resource>.services.ai.azure.com

# MAI-Transcribe-2-Streaming deployment name on that resource.
KSTT_MAI_STREAMING_DEPLOYMENT=<mai-streaming-deployment>

# LLM semantic judge (`kstt judge`, optional). Judge calls send reference transcripts and STT hypotheses
# (text only) to this Azure OpenAI deployment. Live judge calls need approval; use --dry-run first.
# KSTT_JUDGE_AOAI_ENDPOINT=https://<judge-ai-services-resource>.openai.azure.com
# Optional deployment names (defaults: gpt-5-mini and gpt-5.5).
# KSTT_JUDGE_MINI_DEPLOYMENT=gpt-5-mini
# KSTT_JUDGE_LARGE_DEPLOYMENT=gpt-5.5
